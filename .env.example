# Copy to .env.local and fill in. .env.local is gitignored.

# Required. Server-side only — this key never reaches the browser. The agents run
# in a Next.js route handler (app/api/run/route.ts), so the Anthropic client only
# ever exists in the Node process.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. The analyst and strategist run on Haiku by default — structured
# classification against a tight schema is what a small fast model is for.
AGENT_MODEL=claude-haiku-4-5-20251001

# Optional. The reviewer escalates to this model when a proposed concession is
# over the escalation threshold in lib/policy.ts. Capability where the money is.
REVIEWER_ESCALATION_MODEL=claude-sonnet-5
